# ============================
#   ESP32‑C3 — BLE ONLY
#   ADC ONESHOT
#   NO LEGACY ADC
# ============================

# --- Bluetooth ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CONTROLLER_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BLE_MAX_ADVERTISING=1
CONFIG_BTDM_CTRL_BLE_MAX_SCAN=1

# --- Wi-Fi OFF (must be OFF on ESP32‑C3 when using ADC1 + BLE) ---
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_WIFI_STA_ENABLE=n
CONFIG_ESP_WIFI_AP_ENABLE=n

# --- ADC: enable new driver, disable legacy ---
CONFIG_ADC_ONESHOT_CTRL_ENABLED=y
CONFIG_ADC_CONTINUOUS_CTRL_ENABLED=y
CONFIG_ADC_CALIBRATION_ENABLED=y
CONFIG_ADC_CALI_SCHEME_CURVE_FITTING_SUPPORTED=y
CONFIG_ADC_CALI_SCHEME_LINE_FITTING_SUPPORTED=n
CONFIG_ADC_DISABLE_LEGACY_DRIVER=y

# --- I2C: disable old driver ---
CONFIG_I2C_ENABLE=y
CONFIG_I2C_MASTER_ISR_IN_IRAM=y
CONFIG_I2C_ISR_IRAM_SAFE=y
CONFIG_I2C_DRIVER=y
CONFIG_I2C_MASTER=y
CONFIG_I2C_ENABLE_OLD_DRIVER=n

# --- GPIO ---
CONFIG_GPIO_ENABLE_GPIO_HOLD=0

# --- Power management ---
CONFIG_PM_POWER_DOWN_PERIPH_IN_LIGHT_SLEEP=0

# --- Flash size (Beetle ESP32‑C3 = 4MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
